    0000 00000000      58           LABEL_TITLE   ^PDP-11 Mnemonic^
    002D 0008056F      59           BASE_TITLE    ^octal^
    0031 0024          60           DEFAULT_WIDTH 36
    0030 7530          61           MAX_INSTRUCTION 30000
                       62 
                       63 *
                       64 *  Tunables
                       65 *
             < 0020 >  66 SCANMAX   CONSTANT  32              ; states searched for the next fetch
             < 000C >  67 GUESSMAX  CONSTANT  12              ; same, when recovering a lost chain
    0034 02000000      68 VEC_LIMIT CONSTANT  1000Q           ; reads below this may be vectors
                       69 
                       70 *
                       71 *  Masks and flags
                       72 *
    0036 FFFF0003      73 A18       CONSTANT  777777Q         ; Unibus address
    0038 FFFF0000      74 W16       CONSTANT  177777Q         ; Unibus data word
    003A 1FFF0000      75 PG13      CONSTANT  17777Q          ; offset within an 8KB MMU page
         < FFFFFFFF >  76 NOMATCH   CONSTANT  0FFFFFFFFH      ; never equal to a bus address
    003C FFFF0000      77 UTAGMASK  CONSTANT  0FFFFH          ; user part of INPUT_TAG
    000B 24202020      78 BLANKS    ASCII     "                                    "
                       79 
                       80 *
                       81 *  User tags written into the acquisition memory
                       82 *
             < 0001 >  83 TG_FETCH  CONSTANT  1               ; instruction fetch
             < 0002 >  84 TG_OPER   CONSTANT  2               ; extension word of an instruction
             < 0003 >  85 TG_DATA   CONSTANT  3               ; data cycle of an instruction
             < 0004 >  86 TG_VEC    CONSTANT  4               ; interrupt / trap vector read
                       87 
                       88 *
                       89 *  How the next instruction fetch is found (TTYPE)
                       90 *
             < 0000 >  91 TT_SEQ    CONSTANT  0               ; next sequential instruction
             < 0001 >  92 TT_BRANCH CONSTANT  1               ; sequential or BRT
             < 0002 >  93 TT_OPWABS CONSTANT  2               ; target = last extension word
             < 0003 >  94 TT_OPWREL CONSTANT  3               ; target = PC relative extension word
             < 0004 >  95 TT_READ   CONSTANT  4               ; target = data of data read NSKIP
             < 0005 >  96 TT_UNKN   CONSTANT  5               ; first read after NSKIP data reads
                       97 
                       98 *
                       99 *  Variables
                      100 *
    003E 00000000     101 OPC       VARIABLE  0               ; opcode being decoded
    0040 00000000     102 PCA       VARIABLE  0               ; its bus address
    0042 00000000     103 CURSTAT   VARIABLE  0               ; STAT of the state being displayed
    0044 00000000     104 TAGCUR    VARIABLE  0               ; user tag of that state
    0046 00000000     105 NOPW      VARIABLE  0               ; number of extension words
    0048 00000000     106 OPWN      VARIABLE  0               ; extension words found
    004A 00000000     107 OPW1      VARIABLE  0               ; first extension word
    004C 00000000     108 OPW2      VARIABLE  0               ; second extension word
    004E 00000000     109 NXOPW     VARIABLE  0               ; address of next extension word
    0050 00000000     110 OPWI      VARIABLE  0               ; extension words printed so far
    0052 00000000     111 OPWA      VARIABLE  0               ; address of word being printed
    0054 00000000     112 OPWMISS   VARIABLE  0               ; extension word was not found
