                      862 *
                      863 *  PCREL - accumulator = BASE + 16 bit displacement in the accumulator.
                      864 *
                      865 *  Below the I/O page the sum is a (sign extended) bus address.  Code
                      866 *  running in the I/O page (e.g. boot ROMs) uses 16 bit virtual addresses
                      867 *  that map 160000-177777 to 760000-777777.
                      868 *
    026B              869 PCREL
    026B 161C         870           AND       W16
    026C A5EF01C1     871           IF        15,15 = 1 THEN INCLUSIVE_OR 0FFFF0000H
    026F 123E         872           ADD       BASE
    0270 083D         873           STORE     TMP
    0271 103E         874           LOAD      BASE
    0272 A62D01DF     875           IF        17,13 = 37Q THEN GOTO PCR_IO
    0275 103D         876           LOAD      TMP
    0276 161B         877           AND       A18
    0277 0013         878           RETURN
    0278              879 PCR_IO
    0278 103D         880           LOAD      TMP
    0279 161C         881           AND       W16
    027A A5ED01C7     882           IF        15,13 = 7 THEN INCLUSIVE_OR 600000Q
    027D 0013         883           RETURN
